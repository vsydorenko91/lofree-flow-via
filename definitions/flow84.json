  "customKeycodes": [
    {
      "name": "Bluetooth 1 (05:0000)",
      "title": "Stock Bluetooth slot 1; hold may enter pairing. Retain/restore at original slot only.",
      "shortName": "BT1"
    },
    {
      "name": "Bluetooth 2 (05:0001)",
      "title": "Stock Bluetooth slot 2; hold may enter pairing. Retain/restore at original slot only.",
      "shortName": "BT2"
    },
    {
      "name": "Bluetooth 3 (05:0002)",
      "title": "Stock Bluetooth slot 3; hold may enter pairing. Retain/restore at original slot only.",
      "shortName": "BT3"
    },
    {
      "name": "Side RGB effect (05:0004)",
      "title": "Cycles the side RGB effect: steady, breathing, off. Stock handler saves settings. Retain/restore at original slot only.",
      "shortName": "RGB FX"
    },
    {
      "name": "Side RGB color (05:0007)",
      "title": "Cycles the side RGB color through 8 colors. Stock handler saves settings. Retain/restore at original slot only.",
      "shortName": "RGB Col"
    },
    {
      "name": "Backlight brightness up (05:000F)",
      "title": "Raises stock brightness index up to 4. Stock handler saves settings. Retain/restore at original slot only.",
      "shortName": "BL+"
    },
    {
      "name": "Backlight brightness down (05:0010)",
      "title": "Lowers stock brightness index down to 0. Stock handler saves settings. Retain/restore at original slot only.",
      "shortName": "BL-"
    },
    {
      "name": "Windows mode (05:0018)",
      "title": "Selects stock Windows OS bank. Stock handler changes saved settings. Retain/restore at original slot only.",
      "shortName": "WinOS"
    },
    {
      "name": "Mac mode (05:0019)",
      "title": "Selects stock Mac OS bank. Stock handler changes saved settings. Retain/restore at original slot only.",
      "shortName": "MacOS"
    },
    {
      "name": "Factory macro 4: Win+Tab (09:0004)",
      "title": "Plays the existing stock Win+Tab macro; this is not an editable VIA macro. Retain/restore at original slot only.",
      "shortName": "WinTab"
    }
  ],
  "menus": [
    {
      "label": "Flow84",
      "content": [
        {
          "label": "Save",
          "content": [
            {
              "label": "Save to keyboard",
              "type": "button",
              "content": [
                "id_flow_save_now",
                0,
                1
              ],
              "options": [
                1
              ]
            },
            {
              "label": "Unsaved changes (read-only)",
              "type": "toggle",
              "content": [
                "id_flow_dirty",
                0,
                13
              ]
            },
            {
              "label": "Note",
              "type": "label",
              "content": [
                "Changes are NOT saved automatically: press Save to keep them after power-off. Flashing firmware clears the saved profile."
              ]
            }
          ]
        },
        {
          "label": "Lighting",
          "content": [
            {
              "label": "Key backlight level (0 = off)",
              "type": "range",
              "content": [
                "id_flow_backlight",
                0,
                6
              ],
              "options": [
                0,
                4
              ]
            },
            {
              "label": "Side RGB color",
