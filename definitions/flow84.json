                11
              ],
              "options": [
                "Steady",
                "Breathing",
                "Off"
              ]
            }
          ]
        },
        {
          "label": "Typing",
          "content": [
            {
              "label": "Tap-hold timeout (mod-tap / layer-tap)",
              "type": "dropdown",
              "content": [
                "id_flow_tap_term",
                0,
                14
              ],
              "options": [
                "Normal (200 ms)",
                "Short (120 ms)",
                "Long (320 ms)",
                "Very long (500 ms)"
              ]
            },
            {
              "label": "Tap-hold becomes hold",
              "type": "dropdown",
              "content": [
                "id_flow_tap_mode",
                0,
                18
              ],
              "options": [
                "When another key is pressed (default)",
                "When another key is pressed and released",
                "Only after the timeout"
              ]
            }
          ]
        },
        {
          "label": "Reset",
          "content": [
            {
              "label": "Reset keys and macros to factory",
              "type": "button",
              "content": [
                "id_flow_factory_reset",
                0,
                16
              ],
              "options": [
                1
              ]
            },
            {
              "label": "Note",
              "type": "label",
              "content": [
                "Takes effect at once but is not saved: press Save to keyboard to keep it, or unplug the keyboard to undo. Reload VIA to see the factory layout. Lighting and the tap-hold timeout are not changed."
              ]
            }
          ]
        },
